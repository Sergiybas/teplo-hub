---
import Layout from '../layouts/Layout.astro';

// Налаштування Telegram-бота
// 1. Створіть бота через @BotFather у Telegram → отримайте токен
// 2. Напишіть боту будь-яке повідомлення, щоб активувати чат
// 3. Відкрийте: https://api.telegram.org/bot<TOKEN>/getUpdates → знайдіть "chat":{"id":...}
// 4. Вставте токен і chat_id нижче (або винесіть у .env як PUBLIC_TG_TOKEN і PUBLIC_TG_CHAT)

const TG_TOKEN = import.meta.env.PUBLIC_TG_TOKEN ?? 'YOUR_BOT_TOKEN';
const TG_CHAT  = import.meta.env.PUBLIC_TG_CHAT  ?? 'YOUR_CHAT_ID';
---
<Layout
  title="Контакти — ТеплоХаб"
  description="Зв'яжіться з ТеплоХаб: залиште заявку, зателефонуйте або напишіть — відповімо протягом дня."
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow on-dark">Зв'язатися</span>
      <h1>Контакти</h1>
      <p>Залиште заявку або зателефонуйте — інженер відповість протягом дня.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap contacts-grid">

      <!-- Контактна інформація -->
      <div class="contacts-copy reveal">
        <span class="eyebrow">Де нас знайти</span>
        <h2 style="margin-top:18px;">Порахуємо ваш<br>проєкт безкоштовно</h2>
        <p>Залиште контакти — інженер зв'яжеться з вами, відповість на питання та запропонує рішення під ваш об'єкт.</p>

        <div class="contacts-info" style="margin-top:40px;">
          <a class="contact-row" href="tel:+380969428474">
            <span class="ci">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.5a16 16 0 0 0 6 6l1-1.2a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7A2 2 0 0 1 22 16.9Z"/></svg>
            </span>
            <span><span class="cl">Телефон</span><span class="cv">+38 096 942 84 74</span></span>
          </a>
          <a class="contact-row" href="mailto:hello@teplohub.ua">
            <span class="ci">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </span>
            <span><span class="cl">Email</span><span class="cv">hello@teplohub.ua</span></span>
          </a>
          <div class="contact-row">
            <span class="ci">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-5.3-7-11a7 7 0 0 1 14 0c0 5.7-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
            </span>
            <span><span class="cl">Регіон обслуговування</span><span class="cv">Нововолинськ, Волинська обл.</span></span>
          </div>
          <div class="contact-row">
            <span class="ci">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            </span>
            <span><span class="cl">Графік роботи</span><span class="cv">Пн–Сб, 9:00–19:00</span></span>
          </div>
        </div>
      </div>

      <!-- Форма -->
      <div class="form-card reveal d2">
        <form id="leadForm" novalidate>
          <h3>Залишити заявку</h3>
          <p class="fc-sub">Відповідаємо протягом робочого дня.</p>
          <div class="field">
            <label for="f-name">Ім'я</label>
            <input id="f-name" name="name" type="text" placeholder="Як до вас звертатися" required />
          </div>
          <div class="field">
            <label for="f-phone">Телефон</label>
            <input id="f-phone" name="phone" type="tel" placeholder="Ваш номер телефону" required />
          </div>
          <div class="field">
            <label for="f-service">Послуга</label>
            <select id="f-service" name="service">
              <option>Опалення «під ключ»</option>
              <option>Тепловий насос</option>
              <option>Монтаж котла</option>
              <option>Тепла підлога</option>
              <option>Водопостачання та каналізація</option>
              <option>Бойлер / ГВП</option>
              <option>Сервіс та ремонт</option>
              <option>Інше / консультація</option>
            </select>
          </div>
          <div class="field">
            <label for="f-msg">Коментар</label>
            <textarea id="f-msg" name="message" placeholder="Коротко про об'єкт і задачу (необов'язково)"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Надіслати заявку <span class="arr">→</span></button>
          <p id="rateError" style="display:none;color:var(--heat-ink);font-size:13px;margin-top:12px;text-align:center;">Забагато спроб. Спробуйте за годину або зателефонуйте нам.</p>
          <p class="form-note">Надсилаючи форму, ви погоджуєтесь на обробку даних.</p>
        </form>
        <div class="form-ok" id="formOk">
          <div class="ok-ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>
          </div>
          <h3>Дякуємо за заявку!</h3>
          <p>Інженер ТеплоХаб зв'яжеться з вами найближчим часом.</p>
        </div>
      </div>

    </div>
  </section>

  <script define:vars={{ TG_TOKEN, TG_CHAT }}>
    const RATE_KEY = 'th_sub';
    const RATE_LIMIT = 3;
    const RATE_WINDOW = 60 * 60 * 1000; // 1 година

    function getRateTimestamps() {
      try {
        const now = Date.now();
        const raw = localStorage.getItem(RATE_KEY);
        return raw ? JSON.parse(raw).filter(t => now - t < RATE_WINDOW) : [];
      } catch { return []; }
    }

    function recordSubmission(timestamps) {
      try { localStorage.setItem(RATE_KEY, JSON.stringify([...timestamps, Date.now()])); } catch {}
    }

    // Прибираємо Markdown-символи з користувацького вводу
    function safe(str) {
      return String(str).trim().slice(0, 500).replace(/[*_`[\]]/g, '');
    }

    const form = document.getElementById('leadForm');
    const ok = document.getElementById('formOk');
    const rateError = document.getElementById('rateError');

    form?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      rateError.style.display = 'none';

      // Rate limit
      const timestamps = getRateTimestamps();
      if (timestamps.length >= RATE_LIMIT) {
        rateError.style.display = 'block';
        return;
      }

      // Валідація
      const nameEl = form.querySelector('#f-name');
      const phoneEl = form.querySelector('#f-phone');
      let valid = true;
      [nameEl, phoneEl].forEach((f) => {
        if (!f.value.trim()) { f.style.borderColor = 'var(--heat)'; valid = false; }
        else { f.style.borderColor = ''; }
      });
      if (!valid) return;

      const service = safe(form.querySelector('#f-service').value);
      const message = safe(form.querySelector('#f-msg').value);
      const name    = safe(nameEl.value);
      const phone   = safe(phoneEl.value);

      const text = [
        '🔥 Нова заявка — ТеплоХаб',
        '',
        `👤 Ім'я: ${name}`,
        `📞 Телефон: ${phone}`,
        `🔧 Послуга: ${service}`,
        message ? `💬 Коментар: ${message}` : '',
      ].filter(Boolean).join('\n');

      recordSubmission(timestamps);

      try {
        await fetch(`https://api.telegram.org/bot${TG_TOKEN}/sendMessage`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ chat_id: TG_CHAT, text }),
        });
      } catch (_) {}

      form.style.display = 'none';
      ok.classList.add('show');
    });
  </script>
</Layout>
